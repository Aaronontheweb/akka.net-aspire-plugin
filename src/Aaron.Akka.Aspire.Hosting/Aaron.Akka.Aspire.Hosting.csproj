<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Aspire hosting integration for Akka.NET clusters. Provides AddAkka(), WithClustering(), and WithReference() for configuring Akka.NET in .NET Aspire AppHost projects.</Description>
    <PackageTags>$(PackageTags);aspire;hosting</PackageTags>
    <IsAspireSharedProject>true</IsAspireSharedProject>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>

</Project>
