<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetStandardLibVersion);net9.0;$(NetLibVersion)</TargetFrameworks>
    <Description>Redis-based service discovery plugin for Akka.NET. Lightweight alternative to Azure Table Storage for cluster member discovery, ideal for .NET Aspire local development.</Description>
    <PackageTags>$(PackageTags);redis;discovery</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka.Discovery" />
    <PackageReference Include="Akka.Hosting" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="reference.conf" />
    <EmbeddedResource Include="reference.conf" />
  </ItemGroup>

</Project>
