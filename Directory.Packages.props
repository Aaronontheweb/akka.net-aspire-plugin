<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Nuget package versions -->
    <AkkaManagementVersion>1.5.59</AkkaManagementVersion>
    <AspireVersion>13.1.0</AspireVersion>
    <XunitVersion>2.9.3</XunitVersion>
  </PropertyGroup>
  <!-- Akka.NET dependencies -->
  <ItemGroup>
    <PackageVersion Include="Akka.Hosting" Version="$(AkkaManagementVersion)"/>
    <PackageVersion Include="Akka.Cluster.Hosting" Version="$(AkkaManagementVersion)"/>
    <PackageVersion Include="Akka.Discovery" Version="$(AkkaManagementVersion)"/>
    <PackageVersion Include="Akka.Management" Version="$(AkkaManagementVersion)"/>
    <PackageVersion Include="Akka.Management.Cluster.Bootstrap" Version="0.3.0-beta4"/>
  </ItemGroup>
  <!-- Aspire dependencies -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)"/>
    <PackageVersion Include="Aspire.Hosting.Redis" Version="$(AspireVersion)"/>
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)"/>
  </ItemGroup>
  <!-- Infrastructure dependencies -->
  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis" Version="2.10.14"/>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.2"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2"/>
  </ItemGroup>
  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="$(XunitVersion)"/>
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
    <PackageVersion Include="FluentAssertions" Version="8.8.0"/>
    <PackageVersion Include="Akka.TestKit.Xunit2" Version="$(AkkaManagementVersion)"/>
  </ItemGroup>
  <!-- SourceLink support -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.102"/>
  </ItemGroup>
</Project>
